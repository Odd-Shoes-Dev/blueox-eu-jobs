# Neon (Postgres) connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Custom email/password auth (currently active — see AUTH.md). Signs/verifies
# session tokens; keep this secret, rotating it invalidates every logged-in session.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_random_secret_here

# Clerk (auth) secret key — NOT currently used (Clerk is dormant, see AUTH.md). Kept
# here so re-enabling Clerk later is just flipping files back, not re-doing setup.
CLERK_SECRET_KEY=your_clerk_secret_key_here

# ImageKit (file storage)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Your media library holds other projects' folders too — scope everything this app
# writes/reads under one root folder so it never touches those. Must start with "/".
IMAGEKIT_ROOT_FOLDER=/blueox

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=https://blueoxjobs.eu,https://www.blueoxjobs.eu,https://admin.blueoxjobs.eu,http://localhost:3000,http://localhost:3001
