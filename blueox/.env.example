# blueox-api backend (Neon DB + ImageKit live behind this)
VITE_API_BASE_URL=http://localhost:3002

# Clerk (auth) — NOT currently used (auth is custom email/password right now, see
# blueox-api/AUTH.md). Kept here so re-enabling Clerk later is just flipping files
# back, not re-doing setup.
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# Business WhatsApp contact link shown across the site (Contact page, Jobs page,
# chatbot). Accepts either a wa.me short link or https://wa.me/<countrycode+number>.
VITE_WHATSAPP_LINK=https://wa.me/message/F6QOLB6IS3VHF1

# Environment
VITE_APP_ENV=development
 